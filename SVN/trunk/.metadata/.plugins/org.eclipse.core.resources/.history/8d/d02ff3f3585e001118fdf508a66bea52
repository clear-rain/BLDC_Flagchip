struct AdcGroupCfg_t * BSP_AdcGetDevice(char *name)
{
	uint8_t i;
	for (i = 0; i < SYS_ADC_GROUP_NUM; i++)
	{
		if (0 == strcmp(s_AdcGroupCfgBuf[i].name, name))
		{
			return &s_AdcGroupCfgBuf[i];
		}
	}
	return NULL;
}


