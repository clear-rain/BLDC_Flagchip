static void FCADC_Init(struct AdcGroupCfg_t *pDev)
{
   ADC_InitType  *tAdcInitCfg;

   tAdcInitCfg =  pDev->pAdcInitCfg;
   tAdcInitCfg->u3AdcFuncClk = PCC_GetPccFunctionClock(pDev->eAdcClkName);
   ADC_Init(pDev->g_tAdcHandle, tAdcInitCfg);

//	   ADC_InitType  tAdcInitCfg;
//	   ADC_InitStructure(&tAdcInitCfg);
//
//	   tAdcInitCfg.u3AdcFuncClk = PCC_GetPccFunctionClock(pDev->eAdcClkName);
//	   ADC_Init(pDev->g_tAdcHandle, &tAdcInitCfg);
   ADC_InitChannel(pDev->g_tAdcHandle, pDev->pAdcChnl, pDev->g_tAdcHandle->tSettings.u8ChnCnt);
   ADC_InitDmaChannel(pDev->ptDmaHandle, pDev->g_tAdcHandle, pDev->pAdcDmaCfg);
   ADC_Enable(pDev->g_tAdcHandle);
}

static void FCADC_Start(struct AdcGroupCfg_t *pDev)
{
    ADC_Start(pDev->g_tAdcHandle);
}

