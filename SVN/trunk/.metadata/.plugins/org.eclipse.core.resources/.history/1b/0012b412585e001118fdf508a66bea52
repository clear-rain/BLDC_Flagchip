	FTU_PwmModeInit(&g_tFtuPwmHandle, &tPwmModeStruct);

//	TRGSEL_SetTargetTriggerSource(TRGSEL_INSTANCE_0, TRGSEL0_TARGET_PTIMER1_TRG0, TRGSEL0_SRC_FTU0_RELOAD_TRG);
