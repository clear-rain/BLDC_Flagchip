static int32_t  SynAbs(int32_t  Data)
{
	return (Data >= 0) ? Data : -Data;
}

/************************************************************
	把安培值转换为 Q12 电流值
************************************************************/
static int32_t  SynFloatToCurQ12(float CurrentA)
{
	float m_Temp;

	if(CurrentA < 0.0f)
	{
		CurrentA = -CurrentA;
	}

	m_Temp = CurrentA * SYNI_CUR_Q12;
	if(m_Temp > (float)INT32_MAX - 0.5f)
	{
		m_Temp = (float)INT32_MAX;
		return m_Temp;
	}

	return (m_Temp + 0.5f);
}

