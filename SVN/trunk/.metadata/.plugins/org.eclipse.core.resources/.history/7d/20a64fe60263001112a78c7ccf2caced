/************************************************************
	初始位置检测阶段，设置 PWM/桥臂动作
	原 MD380 直接写 AQCSFRC，本移植版只传递 Section 给 USER_PORT
************************************************************/
void SynInitPosDetSetPwm(Uint Section)
{
	Uint m_Section;

	m_Section = Section;

	switch(m_Section)
	{
		case 0:									// A+, B-
			SynUserPortSetBridgeSection(0);
			break;

		case 1:									// A-, B+
			SynUserPortSetBridgeSection(1);
			break;

		case 2:									// B+, C-
			SynUserPortSetBridgeSection(2);
			break;

		case 3:									// B-, C+
			SynUserPortSetBridgeSection(3);
			break;

		case 4:									// A-, C+
			SynUserPortSetBridgeSection(4);
			break;

		case 5:									// A+, C-
			SynUserPortSetBridgeSection(5);
			break;

		case 6:									// 恢复普通 PWM 控制
			SynUserPortSetBridgeSection(6);
			break;

		default:								// 安全关闭/注入初始化状态
			SynUserPortSetBridgeSection(7);
			break;
	}
}
